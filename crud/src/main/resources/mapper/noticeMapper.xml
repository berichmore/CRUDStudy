<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="board.crud.bbs.mapper.NoticeMapper">
<!--    공지사항 리스트 조회 + 페이징-->
    <select id="getPageList" resultType="board.crud.bbs.dto.NoticeDto">
        SELECT      noticeSeq
        ,           userId
        ,           title
        ,           contents
        ,           createdAt
        ,           updatedAt
        FROM notice
        ORDER BY noticeSeq DESC
    </select>

</mapper>